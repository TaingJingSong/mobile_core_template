import 'package:flutter/material.dart';

import 'app/integrations.dart';

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  try {
    await initializeIntegrations();
    runApp(const MyApp());
  } catch (error, stack) {
    runApp(const MaterialApp(home: Scaffold(body: Center(child: Text('Unable to start the app. Please close it and try again.')))));
    FlutterError.reportError(FlutterErrorDetails(exception: error, stack: stack, library: 'application startup'));
  }
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) => MaterialApp(
    title: '{{name}}',
    theme: ThemeData(colorScheme: ColorScheme.fromSeed(seedColor: Colors.blue)),
    home: const Scaffold(body: Center(child: Text('Home View'))),
  );
}
