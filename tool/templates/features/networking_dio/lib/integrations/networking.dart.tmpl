import 'package:dio/dio.dart';

Dio createApiClient({String baseUrl = const String.fromEnvironment('API_BASE_URL')}) {
  final uri = Uri.tryParse(baseUrl);
  if (uri == null || uri.scheme != 'https' || uri.host.isEmpty || uri.userInfo.isNotEmpty ||
      uri.hasQuery || uri.hasFragment || uri.host == 'example.com' ||
      uri.host.endsWith('.example.com') || uri.host.endsWith('.invalid')) {
    throw ArgumentError('Set API_BASE_URL to a real HTTPS API endpoint.');
  }
  return Dio(BaseOptions(baseUrl: baseUrl, connectTimeout: const Duration(seconds: 30), receiveTimeout: const Duration(seconds: 30)));
}
